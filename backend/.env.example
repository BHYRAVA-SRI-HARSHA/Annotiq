# Postgres connection string — Neon / Supabase free tier both work
DATABASE_URL="postgresql://user:password@host:5432/annotiq?schema=public"

# JWT secrets — generate real random strings before deploying
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

PORT=4000
NODE_ENV="development"
# One origin, or a comma-separated list (e.g. when the frontend is served
# from more than one domain — a preview deploy plus production).
CORS_ORIGIN="http://localhost:5173"
# Base URL uploaded document images are served from (backend/public/uploads).
# Only needed if the API isn't reachable at localhost:4000 in your setup.
PUBLIC_ASSET_BASE="http://localhost:4000"

# Uploaded source documents are written to backend/public/uploads and served
# statically from there (see middleware/upload.ts) — there is no object
# storage integration. On a host with an ephemeral filesystem (e.g. most
# free-tier PaaS dynos), mount a persistent volume at that path, or uploads
# won't survive a redeploy/restart.
