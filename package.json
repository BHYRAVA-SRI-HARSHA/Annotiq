{
  "name": "annotiq",
  "private": true,
  "version": "0.1.0",
  "description": "Annotiq — a document annotation platform (queue + canvas annotation + review pipeline).",
  "engines": {
    "node": ">=18.18"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "build": "npm run build:backend && npm run build:frontend",
    "start": "npm run start --workspace backend",
    "prisma:generate": "npm run prisma:generate --workspace backend",
    "prisma:migrate": "npm run prisma:migrate --workspace backend",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace backend",
    "seed": "npm run seed --workspace backend"
  }
}
